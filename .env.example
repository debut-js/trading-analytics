# Read-only API keys. On Binance: API Management → create a key with only "Enable Reading" ticked.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Optional: a second account on Bybit (read-only key). Leave empty for Binance only.
BYBIT_API_KEY=
BYBIT_API_SECRET=

# The page
TITLE=Futures account
# BRAND=My trading
# SITE_HOST=example.com        # canonical host; also redirects www.<host> → <host>

# Optional
# PORT=3000
# DATA_START=2026-01-01        # ignore everything before this UTC day
# INCEPTION=2026-01-01         # the day the account started, for the returns
# TRADES_DAYS=30               # how many days of fills to rebuild trades from (max 90)
# CACHE_TTL_SECONDS=60         # how often the report is rebuilt while someone is looking
# SITE_DIR=./site              # your own slots and files, see README
# DEMO=1                       # serve the bundled sample report, no keys needed

# Lead traders only: show how many accounts copy you
# BINANCE_COPY_PORTFOLIO_ID=   # the number at the end of your binance.com/en/copy-trading/lead-details/<id> link
# BYBIT_COPY_LEADER_MARK=      # the leaderMark of your Bybit copy-trading page
